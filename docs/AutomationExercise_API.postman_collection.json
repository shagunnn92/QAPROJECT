          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('brands is a non-empty array', () => pm.expect(body.brands).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT Brands List - Method Rejected",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/brandsList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "brandsList"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 405', () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Search Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/searchProduct",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "searchProduct"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "search_product",
              "value": "tshirt"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
              "pm.test('products array exists', () => pm.expect(body.products).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Search Product - Missing Parameter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/searchProduct",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "searchProduct"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Missing parameter is reported', () => pm.expect(pm.response.text()).to.include('search_product'));"
            ]
          }
        }
      ]
    },
    {
