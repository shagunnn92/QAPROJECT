{
  "info": {
    "_postman_id": "growthjockey-qa-automationexercise",
    "name": "AutomationExercise QA API Suite",
    "description": "API regression collection based on the public Automation Exercise API practice endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://automationexercise.com"
    },
    {
      "key": "testEmail",
      "value": "qa-{{$timestamp}}@example.com"
    },
    {
      "key": "testPassword",
      "value": "QaTest@12345"
    }
  ],
  "item": [
    {
      "name": "GET Products List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productsList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
              "pm.test('products is a non-empty array', () => pm.expect(body.products).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Products List - Method Rejected",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productsList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 405', () => pm.response.to.have.status(405));",
              "pm.test('Method is not supported', () => pm.expect(pm.response.text()).to.include('not supported'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Brands List",
      "request": {
        "method": "GET",
